{
  "name": "commitizen",
  "version": "0.0.3",
  "description": "Git commit, but play nice with conventions.",
  "main": "dist/index.js",
  "scripts": {
    "check-coverage": "nyc check-coverage --statements 100 --branches 100 --functions 100 --lines 100",
    "commit": "node bin/git-cz",
    "build": "babel src --out-dir dist",
    "build:watch": "babel --watch src --out-dir dist",
    "prepare": "husky || true",
    "prepublishOnly": "npm run build",
    "write-coverage": "nyc report --reporter=lcov --reporter=cobertura --reporter=html",
    "semantic-release": "npx semantic-release",
    "start": "npm run test:watch",
    "test-actual": "mocha --require @babel/register --reporter ./test/reporters/multi-reporter.cjs --reporter-option output=./junit-testresults.xml test/tests/index.js",
    "test": "nyc --require @babel/register npm run test-actual",
    "test:watch": "nodemon -q --ignore test/.tmp/ --ignore test/artifacts/ --ignore coverage/ --exec \"npm run test\" --"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "homepage": "https://github.com/commitizen/cz-cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/commitizen/cz-cli.git"
  },
  "keywords": [
    "commit",
    "pretty",
    "format",
    "conventional changelog",
    "commitizen"
  ],
  "bugs": {
    "url": "https://github.com/commitizen/cz-cli/issues"
  },
  "bin": {
    "cz": "./bin/git-cz",
    "git-cz": "./bin/git-cz",
    "commitizen": "./bin/commitizen"
  },
  "author": "Jim Cummins <jimthedev@gmail.com> (https://github.com/jimthedev)",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/preset-env": "7.29.7",
    "@babel/register": "7.29.7",
    "@istanbuljs/nyc-config-babel": "3.0.0",
    "babel-plugin-istanbul": "7.0.1",
    "chai": "4.5.0",
    "conventional-changelog-conventionalcommits": "7.0.2",
    "cz-conventional-changelog": "3.3.0",
    "cz-conventional-changelog-default-export": "0.0.0-semantically-released.1",
    "husky": "9.1.7",
    "mocha": "12.0.0",
    "nodemon": "3.1.14",
    "nyc": "18.0.0",
    "proxyquire": "2.1.3",
    "semantic-release": "25.0.9",
    "semver": "7.8.5",
    "sinon": "22.1.0",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "cachedir": "2.4.0",
    "dedent": "0.7.0",
    "detect-indent": "6.1.0",
    "find-node-modules": "^2.1.3",
    "find-root": "1.1.0",
    "fs-extra": "11.4.0",
    "glob": "13.0.6",
    "inquirer": "8.2.7",
    "is-utf8": "^0.2.1",
    "lodash": "4.18.1",
    "minimist": "1.2.8",
    "strip-bom": "4.0.0",
    "strip-json-comments": "3.1.1"
  },
  "nyc": {
    "extends": "@istanbuljs/nyc-config-babel",
    "exclude": [
      "test"
    ]
  },
  "engineStrict": true,
  "engines": {
    "node": ">= 20"
  },
  "collective": {
    "type": "opencollective",
    "url": "https://opencollective.com/commitizen"
  },
  "release": {
    "preset": "conventionalcommits"
  }
}
